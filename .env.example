# Chronoscope configuration.
# Every setting is optional; the defaults run a complete, working system.
# Copy to `.env` and edit what you need.

# Security
# Leave CS_API_KEY empty for localhost. Set it (and CS_ALLOWED_HOSTS +
# CS_CORS_ORIGINS) before exposing the service on a network.
# CS_API_KEY=                    # openssl rand -hex 32
CS_ALLOWED_HOSTS=*               # comma-separated Host allowlist
CS_TRUST_PROXY_HEADERS=false     # true ONLY behind a proxy you control
CS_RATE_LIMIT_ENABLED=true
CS_RL_DEFAULT_PER_MIN=240
CS_RL_QUERY_PER_MIN=40
CS_RL_UPLOAD_PER_MIN=24
CS_RL_STREAM_PER_MIN=60
CS_MAX_REQUEST_BYTES=2097152     # non-upload request bodies
CS_MAX_TRANSCRIPT_KB=4096
CS_STORAGE_QUOTA_GB=100
CS_MAX_VIDEO_DURATION_S=21600    # 6 hours
CS_MAX_VIDEO_PIXELS=8847360      # 4096 x 2160
CS_ENABLE_DOCS=true              # false hides /api/docs and the schema

# Runtime
CS_ENV=dev                       # dev | prod | test
CS_LOG_LEVEL=INFO
CS_LOG_JSON=false                # true in production for structured logs
CS_DATA_DIR=./data
CS_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
CS_MAX_UPLOAD_MB=4096
CS_INGEST_CONCURRENCY=2          # videos processed simultaneously
CS_CHECKPOINT_INTERVAL_S=30      # in-process vector index flush cadence

# Vector store
# `qdrant` is the default and falls back automatically to the in-process HNSW
# index if Qdrant is unreachable. Set `memory` to skip Qdrant entirely.
CS_VECTOR_BACKEND=qdrant
CS_QDRANT_URL=http://localhost:6333
# CS_QDRANT_API_KEY=
CS_QDRANT_COLLECTION=chronoscope_chunks
CS_HNSW_M=24
CS_HNSW_EF_SEARCH=96

# Ingestion
CS_SCENE_THRESHOLD=27.0          # lower = more scene cuts
CS_SCENE_MIN_LEN_S=0.8
CS_MAX_KEYFRAMES=400             # global budget, apportioned across scenes
CS_KEYFRAME_DEDUPE_HAMMING=6     # perceptual-hash near-duplicate radius
CS_CHUNK_TARGET_S=22.0
CS_CHUNK_MAX_S=45.0

# Speech
CS_WHISPER_MODEL=base            # tiny | base | small | medium | large-v3
CS_WHISPER_COMPUTE_TYPE=int8     # int8 on CPU, float16 on CUDA
# CS_LANGUAGE=en                 # omit to auto-detect
CS_DIARIZATION_ENABLED=true
# CS_HF_TOKEN=                   # free HuggingFace token enables pyannote;
                                 # without it the spectral fallback is used

# Embeddings
CS_DEVICE=auto                   # auto | cpu | cuda | mps
CS_TEXT_MODEL=sentence-transformers/all-MiniLM-L6-v2
# CS_TEXT_MODEL=nomic-ai/nomic-embed-text-v1.5   # stronger, 768-d
CS_CLIP_MODEL=ViT-B-32
CS_CLIP_PRETRAINED=laion2b_s34b_b79k
CS_EMBED_BATCH_SIZE=16

# Retrieval
CS_RRF_K=60.0                    # rescaled automatically to candidate-list size
CS_RETRIEVAL_CANDIDATES=48
CS_FINAL_K=8
CS_MMR_LAMBDA=0.72               # 1.0 = pure relevance, 0.0 = pure diversity
CS_TEMPORAL_DECAY_S=45.0
CS_NEIGHBOUR_BONUS=0.18

#  Language models (all free options) 
# Tried in order; the first that answers wins. With none reachable the engine
# stays fully functional using deterministic planning and extractive answers.
CS_LLM_PROVIDER_CHAIN=ollama,openrouter,groq

# 1. Ollama, fully local, no key, no cost:
#      ollama pull qwen2.5:7b-instruct && ollama pull llava:7b
CS_OLLAMA_URL=http://localhost:11434
CS_OLLAMA_MODEL=qwen2.5:7b-instruct
CS_OLLAMA_VISION_MODEL=llava:7b

# 2. OpenRouter, free tier; `:free` models cost nothing (key required).
# CS_OPENROUTER_KEY=sk-or-...
CS_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
CS_OPENROUTER_VISION_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free

# 3. Groq, free tier, very fast, text only.
# CS_GROQ_KEY=gsk_...
CS_GROQ_MODEL=llama-3.3-70b-versatile

CS_LLM_TEMPERATURE=0.15
CS_LLM_TIMEOUT_S=120

# Database
# Defaults to SQLite in CS_DATA_DIR. Point at Postgres for multi-worker setups:
# CS_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/chronoscope
